{
  "name": "weapp-pandacss-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "description": "Panda CSS adapters and examples for mini-programs, managed with repoctl",
  "author": "ice breaker <hi@sonofmagic.top>",
  "license": "MIT",
  "homepage": "https://panda.weapp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-pandacss/weapp-pandacss.git"
  },
  "bugs": {
    "url": "https://github.com/weapp-pandacss/weapp-pandacss/issues"
  },
  "keywords": [
    "pandacss",
    "weapp",
    "miniprogram",
    "repoctl",
    "monorepo"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "test": "node -e \"require('node:fs').mkdirSync('coverage/.tmp', { recursive: true })\" && vitest run --maxWorkers=1 && pnpm test:types && pnpm docs:test",
    "test:dev": "node -e \"require('node:fs').mkdirSync('coverage/.tmp', { recursive: true })\" && vitest --maxWorkers=1",
    "lint": "turbo run lint && pnpm lint:e2e && pnpm lint:docs-deploy",
    "tsd": "turbo run tsd",
    "test:types": "turbo run test:types",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit --fix",
    "typecheck": "turbo run typecheck && pnpm typecheck:e2e",
    "format": "eslint . --fix",
    "validate": "pnpm run build && pnpm run lint && pnpm run typecheck && pnpm run tsd && pnpm run test",
    "release": "pnpm change",
    "version-packages": "pnpm version -r",
    "publish-packages": "repo release stable publish",
    "release:pre": "repo release pre publish",
    "------": "--------------",
    "preinstall": "npx only-allow pnpm",
    "commit": "commit",
    "commitlint": "commitlint --edit",
    "sync": "turbo run sync",
    "inspector": "npx @eslint/config-inspector",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build",
    "-------": "---------------",
    "repo:init": "repo init",
    "repo:new": "repo new",
    "repo:check": "repo check",
    "repo:doctor": "repo doctor",
    "------simple": "--------------",
    "pr:alpha": "repo release pre enter alpha",
    "pr:beta": "repo release pre enter beta",
    "pr:rc": "repo release pre enter rc",
    "pr:next": "repo release pre enter next",
    "pr:exit": "repo release pre exit",
    "--------": "----------------",
    "build:examples": "turbo run build --filter=./examples/*",
    "pack:check": "pnpm --filter @weapp-pandacss/runtime pack:check && pnpm --filter weapp-pandacss pack:check",
    "lint:e2e": "eslint e2e playwright.config.ts",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:e2e:web": "turbo run build --filter=@weapp-pandacss/react-app... && playwright test",
    "test:e2e:weapp": "turbo run build --filter=@weapp-pandacss/weapp-vite-app... && vitest run examples/weapp-vite-app/test --coverage.enabled=false",
    "test:e2e:devtools": "turbo run build --filter=@weapp-pandacss/weapp-vite-app... --filter=@weapp-pandacss/taro-app --filter=@weapp-pandacss/taro-app-vue3 --filter=@weapp-pandacss/uni-app-vue3 && node --experimental-strip-types e2e/devtools/run.ts",
    "test:e2e": "pnpm test:e2e:weapp && pnpm test:e2e:web",
    "test:consumer:matrix": "node --experimental-strip-types packages/weapp-pandacss/test/consumer-acceptance.ts",
    "test:e2e:h5": "turbo run build --filter=weapp-pandacss --filter=@weapp-pandacss/runtime && pnpm -r --workspace-concurrency=1 --filter=@weapp-pandacss/taro-app --filter=@weapp-pandacss/taro-app-vue3 --filter=@weapp-pandacss/uni-app-vue3 run build:h5 && playwright test -c e2e/h5/playwright.config.ts",
    "test:e2e:dev": "node --experimental-strip-types e2e/devtools/watch.ts",
    "audit:acceptance": "node --experimental-strip-types e2e/audit.ts",
    "test:acceptance": "node --experimental-strip-types e2e/acceptance.ts",
    "docs:build": "node scripts/docs-deployment/build.mjs",
    "docs:deploy:preview": "node scripts/docs-deployment/deploy.mjs preview",
    "docs:deploy:stable": "node scripts/docs-deployment/deploy.mjs stable",
    "docs:test": "node --test scripts/docs-deployment/*.test.mjs",
    "docs:test:e2e": "node scripts/docs-e2e.mjs",
    "lint:docs-deploy": "eslint scripts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@eslint/config-inspector": "^3.5.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/postcss-import": "14.0.3",
    "@vitest/coverage-v8": "~5.0.5",
    "@weapp-tailwindcss/env": "0.2.0",
    "eslint": "^10.12.0",
    "execa": "^10.1.1",
    "lefthook": "2.2.2",
    "miniprogram-automator": "0.13.0",
    "only-allow": "^1.2.2",
    "postcss": "catalog:",
    "postcss-import": "17.0.1",
    "postcss-less": "^6.0.0",
    "repoctl": "6.0.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-less": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "tsd": "^0.33.0",
    "tsdown": "0.23.1",
    "turbo": "^2.11.8",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
