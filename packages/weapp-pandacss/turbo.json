{
  "extends": [
    "//"
  ],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../examples/build-env.cjs"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../examples/build-env.d.cts"
      ]
    },
    "tsd": {
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "dist/**"
      ]
    }
  }
}
