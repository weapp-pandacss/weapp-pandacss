---
import type { DocsPageProps } from '@cloudflare/nimbus-docs/types'
import { withBase } from '@cloudflare/nimbus-docs/runtime'
import { config } from 'virtual:nimbus/config'
import Head from '../components/head.astro'
import DocIcon from '../components/doc-icon.astro'
import IconControl from '../components/icon-control.astro'
import Search from '../components/search/index.astro'
import Sidebar from '../components/sidebar.astro'
import { labels } from '../lib/locale'
import { documentationSections } from '../lib/navigation'
import '../styles/site.css'

type Props = DocsPageProps & { chinese: boolean, alternate: string }
const { title, description, sidebar, headings, markdownUrl, chinese, alternate, noindex, draft, searchable, breadcrumbs, prevNext } = Astro.props
const text = labels[chinese ? 'zh' : 'en']
const base = import.meta.env.BASE_URL
const root = chinese ? '/zh/' : '/'
const indexUrl = withBase(chinese ? '/zh/llms.txt' : '/llms.txt', base)
const home = Astro.url.pathname === withBase(root, base)
const activeSection = sidebar === false ? undefined : sidebar.find(group => group.type === 'group' && group.children.some(link => link.type === 'link' && withBase(link.href, base) === Astro.url.pathname))?.label
const sections = documentationSections(chinese)
---

<!doctype html>
<html lang={chinese ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('weapp-pandacss:theme')
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      }
      catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
      }
    </script>
    <Head title={title} description={description} markdownUrl={markdownUrl} noindex={noindex || draft} chinese={chinese} />
    <link rel="alternate" type="text/plain" href={indexUrl} title={text.index} />
    <script>
      import { initializeLocale } from '../lib/locale-client'
      import { initializeSite } from '../lib/site-client'

      initializeLocale()
      initializeSite()
    </script>
  </head>
  <body data-home={home ? '' : undefined} data-copy={text.copy} data-copied={text.copied} data-selection={text.selection}>
    <a class="skip-link" href="#main-content">{text.skip}</a>
    <header class="site-header">
      <div class="header-main">
        <a class="brand" href={withBase(root, base)} aria-label={config.title}>
          <img src={withBase('/logo.svg', base)} alt="" width="38" height="38" />
          <span>{config.title}</span>
        </a>
        <span class="version-label">2.0</span>
        <IconControl id="open-search" class="search-trigger" icon="search" label={text.search} data-open-search aria-haspopup="dialog" aria-controls="search-dialog" />
        <nav class="header-links" aria-label={chinese ? '全局导航' : 'Global navigation'}>
          <IconControl id="github-link" class="github-link" icon="github" label={text.github} href="https://github.com/weapp-pandacss/weapp-pandacss" />
          <IconControl id="language-link" class="language-link" icon="languages" label={text.language} href={withBase(alternate, base) + '?lang=' + (chinese ? 'en' : 'zh')} lang={chinese ? 'en' : 'zh-CN'} data-docs-locale={chinese ? 'en' : 'zh'} />
          <IconControl id="theme-trigger" icon="monitor" label={text.theme} popovertarget="theme-popover" aria-controls="theme-popover" aria-expanded="false" data-theme-trigger />
          <div id="theme-popover" class="theme-popover" popover>
            <fieldset><legend>{text.theme}</legend>{(['system', 'light', 'dark'] as const).map(value => <label class="theme-option"><input type="radio" name="theme" value={value} checked={value === 'system'} /><DocIcon name={value === 'system' ? 'monitor' : value === 'light' ? 'sun' : 'moon'} size={18} /><span>{text[value]}</span></label>)}</fieldset>
          </div>
        </nav>
        <IconControl id="open-menu" class="menu-trigger" icon="menu" label={text.menu} data-open-menu aria-haspopup="dialog" aria-controls="navigation-dialog" aria-expanded="false" />
      </div>
      <nav class="section-tabs" aria-label={chinese ? '文档分类' : 'Documentation sections'}>
        {sections.map(section => <a href={withBase(root + section.href, base)} aria-current={activeSection === section.label ? 'true' : undefined}><DocIcon name={section.icon} size={17} />{section.label}</a>)}
      </nav>
    </header>
    <div class="docs-grid">
      <aside class="site-rail" id="site-navigation">
        <nav aria-label={text.navigation}>
          <p class="rail-title">{text.navigation}</p>
          {sidebar !== false && <Sidebar items={sidebar} chinese={chinese} />}
        </nav>
        <IconControl id="rail-index" class="index-link" icon="bot" label={text.index} href={indexUrl} />
      </aside>
      <main id="main-content" tabindex="-1">
        <nav class="breadcrumbs" aria-label={chinese ? '面包屑' : 'Breadcrumbs'}>
          <ol>{breadcrumbs.map((crumb, index) => <li>{crumb.href && index !== breadcrumbs.length - 1 ? <a href={withBase(crumb.href, base)}>{index === 0 && <DocIcon name="home" size={14} />}{crumb.label}</a> : <span aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}>{crumb.label}</span>}</li>)}</ol>
        </nav>
        <div data-pagefind-body={searchable !== false && !noindex && !draft ? '' : undefined} data-pagefind-ignore={searchable === false || noindex || draft ? '' : undefined}>
          <div class="page-heading"><span class="eyebrow">{home ? 'PANDA CSS × MINI-PROGRAMS' : 'WEAPP-PANDACSS / DOCS'}</span><h1>{title}</h1>{description && <p class="description">{description}</p>}</div>
          <article><slot /></article>
        </div>
        <nav class="previous-next" aria-label={chinese ? '文档翻页' : 'Page navigation'}>
          {prevNext.prev && <a href={withBase(prevNext.prev.href, base)} aria-label={text.previous + ': ' + prevNext.prev.label}><DocIcon name="arrow-left" size={20} /><strong>{prevNext.prev.label}</strong></a>}
          {prevNext.next && <a class="next-page" href={withBase(prevNext.next.href, base)} aria-label={text.next + ': ' + prevNext.next.label}><strong>{prevNext.next.label}</strong><DocIcon name="arrow-right" size={20} /></a>}
        </nav>
        {markdownUrl && <footer><IconControl id="read-markdown" icon="file-text" label={text.markdown} href={withBase(markdownUrl, base)} /><IconControl id="footer-index" icon="bot" label={text.index} href={indexUrl} /></footer>}
      </main>
      <aside class="page-rail">
        {headings !== false && headings.length > 0 && <nav aria-label={text.contents}><p class="rail-title"><DocIcon name="list" size={14} />{text.contents}</p><ul class="navigation-list">{headings.map(heading => <li class:list={{ 'toc-nested': heading.depth > 2 }}><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ul></nav>}
      </aside>
    </div>
    <dialog id="navigation-dialog" class="navigation-dialog" aria-label={text.navigation}><div class="dialog-heading"><strong>{text.navigation}</strong><IconControl id="close-menu" icon="x" label={text.close} data-close-menu /></div></dialog>
    <template id="code-copy-template"><IconControl id="code-copy" class="copy-code" icon="copy" label={text.copy} /></template>
    <template id="copy-check-icon"><DocIcon name="check" size={20} /></template>
    <template id="theme-system-icon"><DocIcon name="monitor" size={20} /></template>
    <template id="theme-light-icon"><DocIcon name="sun" size={20} /></template>
    <template id="theme-dark-icon"><DocIcon name="moon" size={20} /></template>
    <Search chinese={chinese} />
  </body>
</html>
