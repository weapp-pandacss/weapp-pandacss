---
import type { DocsPageProps } from '@cloudflare/nimbus-docs/types'
import { withBase } from '@cloudflare/nimbus-docs/runtime'
import { config } from 'virtual:nimbus/config'
import Head from '../components/head.astro'
import Search from '../components/search/index.astro'
import Sidebar from '../components/sidebar.astro'
import { labels } from '../lib/locale'
import { documentationSections } from '../lib/navigation'
import '../styles/site.css'

type Props = DocsPageProps & { chinese: boolean, alternate: string }
const { title, description, sidebar, headings, markdownUrl, chinese, alternate, noindex, draft, searchable, breadcrumbs, prevNext } = Astro.props
const text = labels[chinese ? 'zh' : 'en']
const base = import.meta.env.BASE_URL
const root = chinese ? '/zh/' : '/'
const indexUrl = withBase(chinese ? '/zh/llms.txt' : '/llms.txt', base)
const home = Astro.url.pathname === withBase(root, base)
const activeSection = sidebar === false ? undefined : sidebar.find(group => group.type === 'group' && group.children.some(link => link.type === 'link' && withBase(link.href, base) === Astro.url.pathname))?.label
const sections = documentationSections(chinese)
---

<!doctype html>
<html lang={chinese ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('weapp-pandacss:theme')
        document.documentElement.dataset.theme = saved === 'light' || saved === 'dark' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
      }
      catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
      }
    </script>
    <Head title={title} description={description} markdownUrl={markdownUrl} noindex={noindex || draft} chinese={chinese} />
    <link rel="alternate" type="text/plain" href={indexUrl} title={text.index} />
    <script>
      import { initializeLocale } from '../lib/locale-client'
      import { initializeSite } from '../lib/site-client'

      initializeLocale()
      initializeSite()
    </script>
  </head>
  <body data-home={home ? '' : undefined} data-copy={text.copy} data-copied={text.copied} data-selection={text.selection}>
    <a class="skip-link" href="#main-content">{text.skip}</a>
    <header class="site-header">
      <div class="header-main">
        <a class="brand" href={withBase(root, base)}>
          <img src={withBase('/logo.svg', base)} alt="" width="38" height="38" />
          <span>{config.title}</span>
        </a>
        <span class="version-label">2.0</span>
        <button type="button" class="search-trigger" data-open-search aria-label={text.search} aria-haspopup="dialog" aria-controls="search-dialog">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
          <span>{text.search}</span><kbd>⌘ / Ctrl K</kbd>
        </button>
        <nav class="header-links" aria-label={chinese ? '全局导航' : 'Global navigation'}>
          <a href="https://github.com/weapp-pandacss/weapp-pandacss" class="github-link">GitHub ↗</a>
          <a class="language-link" href={withBase(alternate, base) + '?lang=' + (chinese ? 'en' : 'zh')} lang={chinese ? 'en' : 'zh-CN'} data-docs-locale={chinese ? 'en' : 'zh'}>{chinese ? 'English' : '简体中文'}</a>
          <label class="theme-control"><span class="visually-hidden">{text.theme}</span><select data-theme-select aria-label={text.theme}><option value="system">{text.system}</option><option value="light">{text.light}</option><option value="dark">{text.dark}</option></select></label>
        </nav>
        <button type="button" class="menu-trigger quiet-button" data-open-menu aria-label={text.menu} aria-haspopup="dialog" aria-controls="navigation-dialog" aria-expanded="false">☰</button>
      </div>
      <nav class="section-tabs" aria-label={chinese ? '文档分类' : 'Documentation sections'}>
        {sections.map(section => <a href={withBase(root + section.href, base)} aria-current={activeSection === section.label ? 'true' : undefined}>{section.label}</a>)}
      </nav>
    </header>
    <div class="docs-grid">
      <aside class="site-rail" id="site-navigation">
        <nav aria-label={text.navigation}>
          <p class="rail-title">{text.navigation}</p>
          {sidebar !== false && <Sidebar items={sidebar} />}
        </nav>
        <a class="index-link" href={indexUrl}>llms.txt ↗</a>
      </aside>
      <main id="main-content" tabindex="-1">
        <nav class="breadcrumbs" aria-label={chinese ? '面包屑' : 'Breadcrumbs'}>
          <ol>{breadcrumbs.map((crumb, index) => <li>{crumb.href && index !== breadcrumbs.length - 1 ? <a href={withBase(crumb.href, base)}>{crumb.label}</a> : <span aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}>{crumb.label}</span>}</li>)}</ol>
        </nav>
        <div data-pagefind-body={searchable !== false && !noindex && !draft ? '' : undefined} data-pagefind-ignore={searchable === false || noindex || draft ? '' : undefined}>
          <div class="page-heading"><span class="eyebrow">{home ? 'PANDA CSS × MINI-PROGRAMS' : 'WEAPP-PANDACSS / DOCS'}</span><h1>{title}</h1>{description && <p class="description">{description}</p>}</div>
          <article><slot /></article>
        </div>
        <nav class="previous-next" aria-label={chinese ? '文档翻页' : 'Page navigation'}>
          {prevNext.prev && <a href={withBase(prevNext.prev.href, base)}><span>← {text.previous}</span><strong>{prevNext.prev.label}</strong></a>}
          {prevNext.next && <a class="next-page" href={withBase(prevNext.next.href, base)}><span>{text.next} →</span><strong>{prevNext.next.label}</strong></a>}
        </nav>
        {markdownUrl && <footer><a href={withBase(markdownUrl, base)}>{text.markdown} ↗</a><a href={indexUrl}>{text.index} ↗</a></footer>}
      </main>
      <aside class="page-rail">
        {headings !== false && headings.length > 0 && <nav aria-label={text.contents}><p class="rail-title">{text.contents}</p><ul class="navigation-list">{headings.map(heading => <li class:list={{ 'toc-nested': heading.depth > 2 }}><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ul></nav>}
      </aside>
    </div>
    <dialog id="navigation-dialog" class="navigation-dialog" aria-label={text.navigation}><div class="dialog-heading"><strong>{text.navigation}</strong><button type="button" class="quiet-button" data-close-menu aria-label={text.close}>×</button></div></dialog>
    <Search chinese={chinese} />
  </body>
</html>
