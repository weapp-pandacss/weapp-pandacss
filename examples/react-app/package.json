{
  "name": "@weapp-pandacss/react-app",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "pnpm codegen && tsc && vite build",
    "lint": "eslint src panda.config.ts vite.config.ts && pnpm lint:styles",
    "preview": "vite preview",
    "codegen": "panda codegen",
    "lint:styles": "stylelint --allow-empty-input \"src/**/*.{css,scss,vue}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@weapp-pandacss/runtime": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@pandacss/dev": "2.1.2",
    "@pandacss/preset-base": "2.1.2",
    "@pandacss/preset-panda": "2.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "weapp-pandacss": "workspace:*"
  }
}
