{
  "name": "@weapp-pandacss/react-app",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "pnpm codegen && tsc && vite build",
    "lint": "eslint src panda.config.ts vite.config.ts && pnpm lint:styles",
    "preview": "vite preview",
    "codegen": "panda codegen && weapp-panda codegen",
    "lint:styles": "stylelint --allow-empty-input \"src/**/*.{css,scss,vue}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@pandacss/dev": "2.1.2",
    "@pandacss/preset-base": "2.1.2",
    "@pandacss/preset-panda": "2.1.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "postcss": "catalog:",
    "postcss-rem-to-responsive-pixel": "^6.0.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "weapp-pandacss": "workspace:*",
    "weapp-tailwindcss": "^3.3.7"
  }
}
