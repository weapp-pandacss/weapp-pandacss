{
  "name": "@weapp-pandacss/taro-app-vue3",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "templateInfo": {
    "name": "vue3-NutUI4",
    "typescript": true,
    "css": "sass"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "scripts": {
    "dev": "npm run dev:weapp",
    "build": "pnpm codegen && taro build --type weapp",
    "build:weapp": "taro build --type weapp",
    "build:swan": "taro build --type swan",
    "build:alipay": "taro build --type alipay",
    "build:tt": "taro build --type tt",
    "build:h5": "taro build --type h5",
    "build:rn": "taro build --type rn",
    "build:qq": "taro build --type qq",
    "build:jd": "taro build --type jd",
    "build:quickapp": "taro build --type quickapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:quickapp": "npm run build:quickapp -- --watch",
    "open": "weapp open -p .",
    "codegen": "panda codegen && weapp-panda codegen",
    "lint": "eslint src panda.config.ts vite.config.ts config --no-error-on-unmatched-pattern && pnpm lint:styles",
    "lint:styles": "stylelint --allow-empty-input \"src/**/*.{css,scss,vue}\"",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.8",
    "@nutui/icons-vue-taro": "^0.0.9",
    "@nutui/nutui-taro": "^4.3.11",
    "@tarojs/components": "3.6.34",
    "@tarojs/helper": "3.6.34",
    "@tarojs/plugin-framework-vue3": "3.6.34",
    "@tarojs/plugin-html": "3.6.34",
    "@tarojs/plugin-platform-alipay": "3.6.34",
    "@tarojs/plugin-platform-h5": "3.6.34",
    "@tarojs/plugin-platform-jd": "3.6.34",
    "@tarojs/plugin-platform-qq": "3.6.34",
    "@tarojs/plugin-platform-swan": "3.6.34",
    "@tarojs/plugin-platform-tt": "3.6.34",
    "@tarojs/plugin-platform-weapp": "3.6.34",
    "@tarojs/runtime": "3.6.34",
    "@tarojs/shared": "3.6.34",
    "@tarojs/taro": "3.6.34",
    "vue": "^3.4.31"
  },
  "devDependencies": {
    "@babel/core": "^7.24.8",
    "@pandacss/dev": "2.1.2",
    "@pandacss/preset-base": "2.1.2",
    "@pandacss/preset-panda": "2.1.2",
    "@tarojs/cli": "3.6.34",
    "@tarojs/taro-loader": "3.6.34",
    "@tarojs/webpack5-runner": "3.6.34",
    "@types/node": "^20.14.10",
    "@types/webpack-env": "^1.18.5",
    "@vue/babel-plugin-jsx": "^1.2.2",
    "@vue/compiler-sfc": "^3.4.31",
    "babel-loader": "^9.1.3",
    "babel-preset-taro": "3.6.34",
    "cross-env": "^7.0.3",
    "css-loader": "7.1.2",
    "postcss": "catalog:",
    "postcss-rem-to-responsive-pixel": "^6.0.1",
    "style-loader": "4.0.0",
    "tailwindcss": "^3.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "unplugin-vue-components": "^0.27.2",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^3.3.0",
    "weapp-pandacss": "workspace:*",
    "weapp-tailwindcss": "^3.3.7",
    "webpack": "^5.93.0"
  }
}
